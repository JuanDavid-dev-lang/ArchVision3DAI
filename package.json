{
  "name": "archvision-3d-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @archvision/web dev",
    "build": "pnpm --filter @archvision/database build && pnpm --filter @archvision/web build",
    "start": "pnpm --filter @archvision/web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @archvision/database generate",
    "db:migrate": "pnpm --filter @archvision/database migrate",
    "db:deploy": "pnpm --filter @archvision/database migrate:deploy",
    "db:push": "pnpm --filter @archvision/database push",
    "db:studio": "pnpm --filter @archvision/database studio",
    "db:seed": "pnpm --filter @archvision/database seed",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
